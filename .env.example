# Copy to `.env` for local builds. Do not commit real values.
#
# REQUIRED for debug/local: Flutter does NOT auto-load this file.
#   flutter run --dart-define-from-file=.env
#   flutter build apk --debug --dart-define-from-file=.env
# Or use the VS Code / Cursor launch config "durpalla (.env)".
# Without the flag, the app falls back to production apigw.durpalla.com.

# No trailing slash. Public routes are /api/v1/public/* (not under /customer).
API_BASE_URL=https://dev-apigw.durpalla.com/api/v1
# Production: https://apigw.durpalla.com/api/v1

# Optional: Passport login on `users` (…/api/v1/auth/login). Omit to use Customer API.
API_AUTH_BASE_URL=https://dev-apigw.durpalla.com/api/v1

# Optional. When API_BASE_URL is a dev-* host, production asset URLs
# (assets.durpalla.com) are rewritten to this origin (default: dev-assets).
# ASSETS_BASE_URL=https://dev-assets.durpalla.com

PUSHER_KEY=
PUSHER_CLUSTER=ap2
RECAPTCHA_SITE_KEY=

# Optional debug flags (never enable in production release)
# API_DEBUG=false
# HOTEL_API_DEBUG=false
